# Tailwatch hub environment. Copy to hub.env (docker) or /etc/tailwatch/hub.env
# (systemd) and keep it 0600 — it holds secrets. Every non-secret value can also
# be given as a flag (flags win over the environment); secrets (TS_*, *_TOKEN,
# *_SECRET) are environment-only and rejected as flags. Run `tailwatch --help`
# for the authoritative list. Empty/commented values keep the built-in default.

# --- Listener ---------------------------------------------------------------
# "auto" = first Tailscale IPv4 of this node, port 8484. Anything else must be
# host:port. Do not use 0.0.0.0 — the hub is designed to be reachable only
# over the tailnet.
#TAILWATCH_LISTEN=auto
# Serve HTTPS with a certificate from `tailscale cert` (docs/DEPLOY.md).
#TAILWATCH_TLS_CERT=/etc/tailwatch/tls/hub.crt
#TAILWATCH_TLS_KEY=/etc/tailwatch/tls/hub.key
# SQLite database directory (created 0700). The container image sets /data.
#TAILWATCH_DATA_DIR=/data
# Path of the tailscaled LocalAPI socket ("" = platform default).
#TAILWATCH_SOCKET=/var/run/tailscale/tailscaled.sock

# --- Access control -----------------------------------------------------------
# Identities come from tailscaled WhoIs — there are no passwords.
# Logins (comma-separated) that get the admin role.
#TAILWATCH_ADMINS=alice@example.com
# Nodes carrying one of these tags get the admin role.
#TAILWATCH_ADMIN_TAGS=tag:admin
# Who may view. Default "*" = every tailnet identity that can reach the hub.
#TAILWATCH_VIEWERS=*
#TAILWATCH_VIEWER_TAGS=tag:ops
# Allow admins to run control-API actions (authorize, tag, routes, rename,
# key expiry, delete). Needs a control API credential below.
#TAILWATCH_ENABLE_ADMIN_ACTIONS=false

# --- Tailscale control API (optional, enriches the inventory) -----------------
# Preferred: an OAuth client with scope devices:core (read; add write for admin
# actions) and devices:routes (write, for route changes).
#TS_OAUTH_CLIENT_ID=
#TS_OAUTH_CLIENT_SECRET=
# Alternative: a personal API key (expires after 90 days).
#TS_API_KEY=
# "-" = the tailnet the credential belongs to.
#TAILWATCH_TAILNET=-
#TAILWATCH_API_BASE_URL=https://api.tailscale.com
#TAILWATCH_API_INTERVAL=60s        # 30s–24h

# --- Collection -----------------------------------------------------------------
#TAILWATCH_POLL_INTERVAL=15s       # LocalAPI poll (5s–1h)
#TAILWATCH_PING_INTERVAL=30s       # disco pings from the hub (10s–1h); 0 disables
#TAILWATCH_PING_CONCURRENCY=8
#TAILWATCH_AGENT_ENABLED=true
#TAILWATCH_AGENT_PORT=41820
#TAILWATCH_AGENT_CONCURRENCY=8
#TAILWATCH_AGENT_TIMEOUT=5s        # 1s–2m
# Shared secret sent to agents as X-Tailwatch-Token (agents run --auth token|both).
#TAILWATCH_AGENT_TOKEN=

# --- Retention ------------------------------------------------------------------
#TAILWATCH_RAW_RETENTION=48h       # all retentions: at least 1h
#TAILWATCH_ROLLUP_RETENTION=2160h  # 90 days
#TAILWATCH_EVENT_RETENTION=2160h   # 90 days

# --- Notifications --------------------------------------------------------------
#TAILWATCH_WEBHOOK_URL=https://example.com/hooks/tailwatch
#TAILWATCH_WEBHOOK_SECRET=          # adds X-Tailwatch-Signature: sha256=<hmac>
#TAILWATCH_SLACK_WEBHOOK_URL=       # Slack/Discord-compatible {"text": ...}
#TAILWATCH_NTFY_URL=https://ntfy.sh/your-private-topic
#TAILWATCH_NTFY_TOKEN=

# --- Logging ------------------------------------------------------------------------
#TAILWATCH_LOG_LEVEL=info          # debug|info|warn|error
#TAILWATCH_LOG_JSON=true

# --- Extra flags (systemd unit only; appended to the command line) ------------------
#TAILWATCH_OPTS=
